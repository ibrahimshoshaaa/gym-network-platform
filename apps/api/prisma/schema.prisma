generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLATFORM_ADMIN
  GYM_OWNER
  BRANCH_MANAGER
  CASHIER
  TRAINEE
}

enum GymStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum InvitationType {
  OWNER
  STAFF
}

enum BranchStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum TopupKind {
  TRAINEE
  BRANCH_STOCK
}

enum PaymentMethodType {
  INSTAPAY
  WALLET
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PointAccountType {
  ISSUANCE
  BRANCH_INVENTORY
  TRAINEE_WALLET
  REDEEMED
  EXPIRED
}

enum PointTxKind {
  ISSUE
  TRANSFER
  VISIT
  VISIT_REVERSAL
  SALE_REVERSAL
  EXPIRY
  ADJUSTMENT
}

enum VisitStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum MoneyAccountType {
  PLATFORM_OFFSET
  GYM_AVAILABLE
  GYM_RESERVED
  GYM_DISPUTED
  GYM_PAID
}

enum MoneyTxKind {
  VISIT_SETTLEMENT
  VISIT_REVERSAL
  WITHDRAWAL_RESERVE
  WITHDRAWAL_RELEASE
  WITHDRAWAL_PAYMENT
  ADJUSTMENT
}

enum WithdrawalStatus {
  REQUESTED
  APPROVED
  REJECTED
  PAID
  DISPUTED
}

model User {
  id              String            @id @default(uuid()) @db.Uuid
  phoneE164       String            @unique
  email           String?           @unique
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  password        UserPassword?
  displayName     String
  role            UserRole
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  ownedGyms       Gym[]             @relation("GymOwner")
  assignments     StaffAssignment[]
  pointAccounts   PointAccount[]
  visits          Visit[]           @relation("TraineeVisits")
  sessions        AuthSession[]
  invitations     StaffInvitation[]
  receipts        ReceiptEvidence[]
  topupRequests   TopupRequest[]    @relation("TopupRequestor")
}

model Gym {
  id              String              @id @default(uuid()) @db.Uuid
  name            String
  ownerId         String              @db.Uuid
  ownerAcceptedAt DateTime?
  owner           User                @relation("GymOwner", fields: [ownerId], references: [id])
  status          GymStatus           @default(PENDING)
  description     String              @default("")
  contactPhone    String?
  invitations     StaffInvitation[]
  branches        Branch[]
  moneyAccounts   MoneyAccount[]
  withdrawals     WithdrawalRequest[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([ownerId])
}

model Branch {
  id                String                 @id @default(uuid()) @db.Uuid
  gymId             String                 @db.Uuid
  gym               Gym                    @relation(fields: [gymId], references: [id])
  name              String
  status            BranchStatus           @default(PENDING)
  visitPricePoints  Int
  sessionMinutes    Int
  address           String                 @default("")
  governorate       String                 @default("")
  city              String                 @default("")
  contactPhone      String?
  openingHours      String?
  pricingVersion    Int                    @default(0)
  priceApprovedAt   DateTime?
  priceApprovedById String?                @db.Uuid
  pricingRequests   BranchPricingRequest[]
  invitations       StaffInvitation[]
  latitude          Decimal?               @db.Decimal(10, 7)
  longitude         Decimal?               @db.Decimal(10, 7)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  staff             StaffAssignment[]
  pointAccounts     PointAccount[]
  visits            Visit[]
  topups            TopupRequest[]
  moneyAccounts     MoneyAccount[]
  withdrawals       WithdrawalRequest[]

  @@unique([id, gymId])
  @@index([gymId, status])
}

model StaffAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  branchId  String   @db.Uuid
  role      UserRole
  active    Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id])
  branch    Branch   @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, branchId, role])
}

model PointAccount {
  id          String           @id @default(uuid()) @db.Uuid
  type        PointAccountType
  ownerUserId String?          @db.Uuid
  ownerUser   User?            @relation(fields: [ownerUserId], references: [id])
  branchId    String?          @db.Uuid
  branch      Branch?          @relation(fields: [branchId], references: [id])
  balance     Int              @default(0)
  expiresAt   DateTime?
  postings    PointPosting[]
  createdAt   DateTime         @default(now())

  @@unique([type, ownerUserId])
  @@unique([type, branchId])
}

model PointTransaction {
  id             String            @id @default(uuid()) @db.Uuid
  idempotencyKey String            @unique
  requestHash    String
  posted         Boolean           @default(false)
  reversalOfId   String?           @unique @db.Uuid
  reversalOf     PointTransaction? @relation("PointReversal", fields: [reversalOfId], references: [id])
  reversedBy     PointTransaction? @relation("PointReversal")
  visit          Visit?
  topup          TopupRequest?
  kind           PointTxKind
  actorId        String?           @db.Uuid
  referenceId    String?           @db.Uuid
  reason         String?
  createdAt      DateTime          @default(now())
  postings       PointPosting[]

  @@index([referenceId])
}

model PointPosting {
  id            String           @id @default(uuid()) @db.Uuid
  transactionId String           @db.Uuid
  accountId     String           @db.Uuid
  delta         Int
  transaction   PointTransaction @relation(fields: [transactionId], references: [id])
  account       PointAccount     @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([transactionId])
}

model TopupRequest {
  id                 String             @id @default(uuid()) @db.Uuid
  requestorUserId    String             @db.Uuid
  requestorUser      User               @relation("TopupRequestor", fields: [requestorUserId], references: [id])
  kind               TopupKind?
  idempotencyKey     String?            @unique
  requestHash        String?
  policyId           String?            @db.Uuid
  policy             PricingPolicy?     @relation(fields: [policyId], references: [id])
  receiptId          String?            @unique @db.Uuid
  receipt            ReceiptEvidence?   @relation(fields: [receiptId], references: [id])
  pointTransactionId String?            @unique @db.Uuid
  pointTransaction   PointTransaction?  @relation(fields: [pointTransactionId], references: [id])
  paymentMethodType  PaymentMethodType?
  paymentAccount     String?
  paymentAccountName String?
  paymentReference   String?            @unique
  unitPricePiasters  BigInt?
  discountBps        Int?
  redemptionBps      Int?
  reviewReason       String?
  receivingBranchId  String?            @db.Uuid
  receivingBranch    Branch?            @relation(fields: [receivingBranchId], references: [id])
  points             Int
  chargePiasters     BigInt
  receiptObjectKey   String
  status             RequestStatus      @default(PENDING)
  reviewedById       String?            @db.Uuid
  reviewedAt         DateTime?
  createdAt          DateTime           @default(now())

  @@index([status, createdAt])
}

model PointSale {
  id                 String   @id @default(uuid()) @db.Uuid
  branchId           String   @db.Uuid
  traineeId          String   @db.Uuid
  cashierId          String   @db.Uuid
  traineeLabel       String
  phoneLast4         String
  points             Int
  chargePiasters     BigInt
  unitPricePiasters  BigInt
  policyId           String   @db.Uuid
  pricingVersion     Int
  idempotencyKey     String   @unique
  requestHash        String
  pointTransactionId String   @unique @db.Uuid
  createdAt          DateTime @default(now())

  @@index([branchId, createdAt])
  @@index([traineeId, createdAt])
}

model QrTicket {
  userId     String    @id @db.Uuid
  tokenHash  String    @unique
  sessionId  String    @db.Uuid
  expiresAt  DateTime
  consumedAt DateTime?
  visitId    String?   @db.Uuid
}

model VisitEntry {
  id             String   @id @default(uuid()) @db.Uuid
  idempotencyKey String   @unique
  requestHash    String
  actorId        String   @db.Uuid
  branchId       String   @db.Uuid
  visitId        String   @db.Uuid
  alreadyActive  Boolean
  createdAt      DateTime @default(now())
}

model Visit {
  id                   String           @id @default(uuid()) @db.Uuid
  traineeId            String           @db.Uuid
  trainee              User             @relation("TraineeVisits", fields: [traineeId], references: [id])
  branchId             String           @db.Uuid
  branch               Branch           @relation(fields: [branchId], references: [id])
  cashierId            String           @db.Uuid
  pointsCharged        Int
  settlementPiasters   BigInt
  policyId             String?          @db.Uuid
  unitPricePiasters    BigInt?
  redemptionBps        Int?
  branchPricingVersion Int?
  status               VisitStatus      @default(ACTIVE)
  startedAt            DateTime         @default(now())
  expiresAt            DateTime
  cancelledAt          DateTime?
  cancelledById        String?          @db.Uuid
  cancellationReason   String?
  pointTransactionId   String           @unique @db.Uuid
  moneyTransactionId   String           @unique @db.Uuid
  pointTransaction     PointTransaction @relation(fields: [pointTransactionId], references: [id])
  moneyTransaction     MoneyTransaction @relation(fields: [moneyTransactionId], references: [id])

  @@index([traineeId, branchId, status])
  @@index([branchId, startedAt])
}

model MoneyAccount {
  id              String           @id @default(uuid()) @db.Uuid
  type            MoneyAccountType
  gymId           String?          @db.Uuid
  gym             Gym?             @relation(fields: [gymId], references: [id])
  branchId        String?          @db.Uuid
  branch          Branch?          @relation(fields: [branchId, gymId], references: [id, gymId])
  balancePiasters BigInt           @default(0)
  postings        MoneyPosting[]

  @@index([type, gymId, branchId])
}

model MoneyTransaction {
  id             String            @id @default(uuid()) @db.Uuid
  idempotencyKey String            @unique
  requestHash    String
  posted         Boolean           @default(false)
  actorId        String            @db.Uuid
  reversalOfId   String?           @unique @db.Uuid
  reversalOf     MoneyTransaction? @relation("MoneyReversal", fields: [reversalOfId], references: [id])
  reversedBy     MoneyTransaction? @relation("MoneyReversal")
  visit          Visit?
  kind           MoneyTxKind
  referenceId    String?           @db.Uuid
  reason         String?
  createdAt      DateTime          @default(now())
  postings       MoneyPosting[]

  @@index([referenceId])
}

model MoneyPosting {
  id            String           @id @default(uuid()) @db.Uuid
  transactionId String           @db.Uuid
  accountId     String           @db.Uuid
  deltaPiasters BigInt
  transaction   MoneyTransaction @relation(fields: [transactionId], references: [id])
  account       MoneyAccount     @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([transactionId])
}

model WithdrawalRequest {
  id               String           @id @default(uuid()) @db.Uuid
  gymId            String           @db.Uuid
  gym              Gym              @relation(fields: [gymId], references: [id])
  branchId         String?          @db.Uuid
  branch           Branch?          @relation(fields: [branchId, gymId], references: [id, gymId])
  amountPiasters   BigInt
  status           WithdrawalStatus @default(REQUESTED)
  requestedAt      DateTime         @default(now())
  acceptedAt       DateTime?
  paidAt           DateTime?
  reviewedById     String?          @db.Uuid
  transferProofKey String?
  rejectionReason  String?

  @@index([gymId, status])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @db.Uuid
  action    String
  entityId  String   @db.Uuid
  reason    String
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityId])
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model UserPassword {
  userId       String   @id @db.Uuid
  user         User     @relation(fields: [userId], references: [id])
  passwordHash String
  changedAt    DateTime @default(now())
}

model AuthThrottle {
  key       String   @id
  attempts  Int
  expiresAt DateTime

  @@index([expiresAt])
}

model StaffInvitation {
  id          String         @id @default(uuid()) @db.Uuid
  type        InvitationType
  tokenHash   String         @unique
  userId      String         @db.Uuid
  user        User           @relation(fields: [userId], references: [id])
  gymId       String         @db.Uuid
  gym         Gym            @relation(fields: [gymId], references: [id])
  branchId    String?        @db.Uuid
  branch      Branch?        @relation(fields: [branchId, gymId], references: [id, gymId])
  role        UserRole
  createdById String         @db.Uuid
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime       @default(now())

  @@index([gymId, createdAt])
  @@index([userId])
}

model BranchPricingRequest {
  id                     String        @id @default(uuid()) @db.Uuid
  branchId               String        @db.Uuid
  branch                 Branch        @relation(fields: [branchId], references: [id])
  requestedById          String        @db.Uuid
  visitPricePoints       Int
  sessionMinutes         Int
  baseVersion            Int
  previousPricePoints    Int
  previousSessionMinutes Int
  status                 RequestStatus @default(PENDING)
  reason                 String
  reviewedById           String?       @db.Uuid
  reviewReason           String?
  reviewedAt             DateTime?
  createdAt              DateTime      @default(now())

  @@index([branchId, createdAt])
}

model PricingPolicy {
  id                 String         @id @default(uuid()) @db.Uuid
  version            Int            @unique
  pointPricePiasters BigInt
  gymDiscountBps     Int
  redemptionBps      Int
  createdById        String         @db.Uuid
  createdAt          DateTime       @default(now())
  topups             TopupRequest[]
}

model PaymentMethod {
  id          String            @id @default(uuid()) @db.Uuid
  type        PaymentMethodType @unique
  account     String
  accountName String
  enabled     Boolean
  version     Int               @default(1)
  updatedAt   DateTime          @updatedAt
}

model TopupPackage {
  id        String    @id @default(uuid()) @db.Uuid
  label     String
  kind      TopupKind
  points    Int
  enabled   Boolean   @default(true)
  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ReceiptEvidence {
  id          String        @id @default(uuid()) @db.Uuid
  ownerUserId String        @db.Uuid
  owner       User          @relation(fields: [ownerUserId], references: [id])
  objectKey   String        @unique
  assetId     String        @unique
  contentHash String        @unique
  mimeType    String
  bytes       Int
  createdAt   DateTime      @default(now())
  topup       TopupRequest?

  @@index([ownerUserId, createdAt])
}
