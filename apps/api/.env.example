DATABASE_URL="postgresql://gym_dev:gym_dev@localhost:5432/gym_dev?schema=public"
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# Private authenticated receipt images; set only in the server secret store.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Phone OTP: disabled unless explicitly set to textbee or test.
GYMBANK_OTP_MODE=
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# Server-only random secret, at least 32 characters. Never NEXT_PUBLIC_ or Flutter defines.
GYMBANK_OTP_SECRET=
# Optional: current subscription ID shown in the TextBee Android app for dual SIM.
# TEXTBEE_SIM_SUBSCRIPTION_ID=

# WhatsApp foundation only; these allow webhook handshake/signature checks,
# NOT live phone verification. Leave empty until rollout is explicitly planned.
# Independent random server-only value, at least 32 characters.
GYMBANK_WHATSAPP_VERIFY_TOKEN=
GYMBANK_WHATSAPP_APP_SECRET=
