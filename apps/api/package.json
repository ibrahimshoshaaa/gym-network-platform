{
  "name": "@gym/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test": "node --import tsx --test test/*.test.ts",
    "test:db": "node --import tsx --test --test-concurrency=1 test-db/*.test.ts",
    "admin:provision": "node --import tsx src/cli/provision-admin.ts",
    "test:runtime": "node --no-experimental-require-module --test test-runtime/*.test.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "cloudinary": "^2.11.0",
    "fastify": "^5.6.1",
    "sharp": "^0.35.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "prisma": "^6.16.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./src/embedded.ts",
      "default": "./src/embedded.ts"
    }
  }
}
