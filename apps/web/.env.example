# Set true to run the API inside this Next.js deployment.
GYM_EMBEDDED_API=true
# Restricted Neon application connection, never a migration-owner URL.
DATABASE_URL=
WEB_ORIGIN=http://localhost:3000
# For standalone local API development set embedded mode false and use:
# API_INTERNAL_URL=http://127.0.0.1:4000

# Embedded API only: server secrets for the inactive WhatsApp foundation.
GYMBANK_WHATSAPP_VERIFY_TOKEN=
GYMBANK_WHATSAPP_APP_SECRET=

# Enable only after migration + webhook subscription + inbound acceptance test.
GYMBANK_WHATSAPP_ENABLED=false
GYMBANK_WHATSAPP_PHONE=+201214829716
GYMBANK_WHATSAPP_PHONE_NUMBER_ID=
