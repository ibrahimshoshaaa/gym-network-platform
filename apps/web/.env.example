# Server-only. Use HTTPS in production except for loopback API traffic on the same host.
API_INTERNAL_URL=http://127.0.0.1:4000
# Exact browser origin; required in production. No trailing path.
WEB_ORIGIN=http://localhost:3000
# Required when API_INTERNAL_URL points to Neon Functions; server-only, same
# randomly generated value as the API function. Never prefix with NEXT_PUBLIC_.
# API_ORIGIN_SECRET=
